{
  "expo": {
    "name": "MYOPS Mobile",
    "slug": "myopsmobile",
    "scheme": "myops",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "platforms": [
      "android",
      "ios"
    ],
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "ios": {
      "bundleIdentifier": "my.myops.mobile",
      "supportsTablet": true
    },
    "android": {
      "package": "my.myops.mobile"
    }
  }
}